{
  "repository": "git@github.com:mainset/ui-stack.git",
  "author": "Yevhen Uzhva <yevhen.uzhva@gmail.com>",
  "license": "CC-BY-NC-4.0",
  "private": false,
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" --parallel dev",
    "dev:apps": "pnpm --filter \"./apps/**\" dev",
    "dev:packages": "pnpm --filter \"./packages/**\" dev",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "codegen:check": "pnpm --filter \"./packages/**\" --if-present codegen:check",
    "check:browser-support": "pnpm --filter \"./packages/**\" --if-present check:browser-support",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "eslint packages",
    "lint:css": "stylelint \"packages/**/*.scss\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@mainset/dev-stack-fe": "^0.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.0"
}

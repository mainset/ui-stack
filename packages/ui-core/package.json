{
  "name": "@mainset/ui-core",
  "version": "0.1.0",
  "description": "Basic SCSS, TypeScript and JS configurations for mainset UI",
  "keywords": [],
  "author": "Yevhen Uzhva <yevhen.uzhva@gmail.com>",
  "license": "CC-BY-NC-4.0",
  "type": "module",
  "sideEffects": [
    "dist/**/*.css"
  ],
  "files": [
    "dist",
    "src/styles/_generated.scss",
    "src/styles/_mixins.scss",
    "src/styles/_variables.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.mts",
      "import": "./dist/esm/index.mjs"
    },
    "./styles/index.css": "./dist/esm/styles/index.css",
    "./styles/foundation.css": "./dist/esm/styles/foundation.css",
    "./styles/reset.css": "./dist/esm/styles/reset.css",
    "./styles/normalize.css": "./dist/esm/styles/reset.css",
    "./scss/mixins": "./src/styles/_mixins.scss"
  },
  "devDependencies": {
    "@mainset/builder-rslib": "^0.3.1",
    "@mainset/cli": "^0.5.0",
    "@mainset/dev-stack-fe": "^0.2.1",
    "@mainset/toolkit-js": "^0.2.0"
  },
  "scripts": {
    "codegen": "node --import ./scripts/ts-hooks.register.mjs ./scripts/codegen.mts",
    "codegen:check": "pnpm run codegen --check",
    "dev": "pnpm run codegen && ms-cli node-sourcer --exec watch -t web --bundless",
    "build": "pnpm run codegen && ms-cli node-sourcer --exec build -t web --bundless && pnpm run check:browser-support",
    "check:browser-support": "node ../../scripts/check-browser-support.mjs dist"
  },
  "packageManager": "pnpm@10.33.0"
}
